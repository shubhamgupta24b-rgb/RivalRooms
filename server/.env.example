PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# dev: local tests only. guest: server-signed players. firebase: Firebase ID tokens.
AUTH_MODE=dev
ALLOW_DEV_AUTH=false
# Required when AUTH_MODE=guest. Use a random string of at least 16 characters. Never commit a real value.
GUEST_TOKEN_SECRET=
MONGO_URI=
RECONNECT_GRACE_MS=60000
CORS_ORIGIN=*
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Alternative to GOOGLE_APPLICATION_CREDENTIALS when AUTH_MODE=firebase. Paste the service-account JSON. Never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=
PRIVACY_CONTACT=you@example.com
